  "description": "Welcome to the Noa-Chan project! This is a personalized, CLI-based AI companion built with Node.js and powered by OpenRouter.",
  "main": "src/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:backend": "bun build src/index.js --compile --outfile desktop-app/src-tauri/noa-backend-x86_64-pc-windows-msvc.exe",
    "build:desktop": "cd desktop-app && bun run tauri build",
    "build": "bun run build:backend && bun run build:desktop",
    "dev": "bun run build:backend && cd desktop-app && bun run tauri dev"
  },
